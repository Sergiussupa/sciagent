{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntityList v0.1",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "contract",
    "paper_id",
    "entities"
  ],

  "properties": {
    "contract": {
      "type": "string",
      "const": "EntityList@0.1"
    },

    "paper_id": {
      "type": "string",
      "minLength": 1
    },

    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },

  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "type",
        "source_element_ids"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "type": "string",
          "minLength": 1
        },

        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "source_element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },

        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
