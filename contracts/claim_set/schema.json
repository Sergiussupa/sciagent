{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimSet@0.1",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "contract",
    "paper_id",
    "claims"
  ],

  "properties": {
    "contract": {
      "const": "ClaimSet@0.1"
    },

    "paper_id": {
      "type": "string",
      "minLength": 1
    },

    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },

  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "kind",
        "text",
        "epistemic_type",
        "source_pages",
        "confidence"
      ],

      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CONTRIBUTION",
            "FINDING",
            "INTERPRETATION",
            "LIMITATION"
          ]
        },

        "text": {
          "type": "string",
          "minLength": 1
        },

        "epistemic_type": {
          "type": "string",
          "enum": [
            "AUTHOR_CLAIM",
            "EXPERIMENTAL_RESULT",
            "INTERPRETATION",
            "LIMITATION"
          ]
        },

        "source_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
