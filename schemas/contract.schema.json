{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciAgent Contract Passport",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "schema"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },

    "description": {
      "type": "string",
      "minLength": 1
    },

    "schema": {
      "type": "string",
      "minLength": 1
    },

    "notes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  }
}
