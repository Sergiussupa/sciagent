{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciAgent Benchmark Specification",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "id",
    "module",
    "description",
    "fixtures",
    "metrics",
    "acceptance"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },

    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },

    "description": {
      "type": "string",
      "minLength": 1
    },

    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "gold"],
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "gold": {
            "type": "string"
          }
        }
      }
    },

    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },

    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "operator", "target"],
        "properties": {
          "metric": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [">=", "<=", ">", "<", "=="]
          },
          "target": {
            "type": "number"
          }
        }
      }
    },

    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
