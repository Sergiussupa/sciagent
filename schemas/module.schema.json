{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciagent.dev/schemas/module.schema.json",
  "title": "SciAgent Module Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "layer",
    "status",
    "description",
    "implementation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": [
        "acquisition",
        "raw_library",
        "document_understanding",
        "canonical_document",
        "knowledge_extraction",
        "knowledge_fabric",
        "retrieval",
        "research_cells",
        "orchestration"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "contract_defined",
        "benchmark_defined",
        "prototype",
        "acceptance_passed",
        "integrated",
        "stable",
        "blocked",
        "deferred"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "outputs": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "depends_on": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exists"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "providers": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "fixtures": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "known_issues": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "target"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            ">=",
            "<=",
            ">",
            "<",
            "=="
          ]
        },
        "target": {
          "type": "number"
        }
      }
    }
  }
}
